{
  "name": "@mac/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mac Bennett worker agent — runs on a dedicated Linux VM",
  "main": "./src/worker.ts",
  "types": "./src/worker.ts",
  "exports": {
    ".": "./src/worker.ts",
    "./config": "./src/config.ts",
    "./logger": "./src/logger.ts",
    "./log-buffer": "./src/log-buffer.ts",
    "./jobs": "./src/jobs/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mac/protocol": "*",
    "dotenv": "^16.4.7",
    "zod": "^3.23.8"
  }
}
