# ---------------------------------------------------------------------------
# Mac Bennett — Sprint 1 environment
#
# Copy to `.env` in the repository root:   cp .env.example .env
# `.env` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Control plane (apps/server) -------------------------------------------

NODE_ENV=development
PORT=8080
HOST=127.0.0.1

# Development database (matches docker-compose.yml).
DATABASE_URL=postgres://mac:mac_dev_password@localhost:5433/mac_bennett

# Separate database used by the integration and e2e test suites.
# Tests refuse to run against DATABASE_URL, so these must differ.
TEST_DATABASE_URL=postgres://mac:mac_dev_password@localhost:5433/mac_bennett_test

# Origin allowed to call the API with credentials. In development the Vite dev
# server proxies /api, so requests are same-origin and this is only a fallback.
WEB_ORIGIN=http://localhost:5173

# Cookie name for the human session. Sessions are server-side and revocable;
# there is no signing secret to leak because the cookie carries an opaque
# random token, not a JWT.
SESSION_COOKIE_NAME=mac_session
SESSION_TTL_HOURS=12

# --- Seed administrator ----------------------------------------------------
# `npm run seed` creates this user if it does not already exist.
# CHANGE THESE before the system is reachable by anyone but you.
SEED_ADMIN_EMAIL=admin@pac-technologies.com.au
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Sprint 1 Administrator

# --- Worker (apps/worker) --------------------------------------------------
# The worker normally runs on a separate Linux VM with its own .env.

# Control-plane base URL as seen from the worker VM.
MAC_CONTROL_PLANE_URL=http://127.0.0.1:8080

# One-time enrollment token, minted by an admin in Settings → Workers.
# Only needed for the worker's very first start; afterwards the worker token
# is persisted to MAC_WORKER_STATE_FILE and this can be removed.
MAC_ENROLLMENT_TOKEN=

# Display name this worker registers under. Must be unique.
MAC_WORKER_NAME=mac-worker-01

# Where the issued worker token is persisted (written with mode 0600).
MAC_WORKER_STATE_FILE=./.mac-worker-state.json

# Directory the `workspace_check` job inspects. On the real VM this is Mac's
# persistent workspace root.
MAC_WORKER_WORKSPACE=./workspace

# The worker refuses a plaintext http:// control plane unless this is true.
# Development only — never set this on a VM that talks over a real network.
MAC_ALLOW_INSECURE_HTTP=true

# Heartbeat cadence is normally taken from server settings; this is only the
# value used before the first successful heartbeat.
MAC_HEARTBEAT_SECONDS=10

# --- Sprint 2: coding agent -------------------------------------------------

# Path to the Claude Code CLI, if `claude` on PATH is not directly spawnable.
# Usually unnecessary: the worker resolves the real binary itself, including
# through npm's shim scripts. Set it for unusual installations.
MAC_CLAUDE_CLI_PATH=

# Opt in to the end-to-end test that drives the REAL Claude Code CLI. It spends
# real subscription usage, so it is skipped unless this is exactly "1".
MAC_E2E_REAL_CLAUDE=

# --- Sprint 3: the execution sandbox ----------------------------------------
#
# Coding agents no longer run with the worker's own view of the filesystem.
# `auto` prefers bubblewrap (no daemon, ~10ms, identity paths) and falls back to
# docker. `none` is a DEVELOPMENT setting: the worker attests no containment and
# the control plane withholds coding work from it while requireSandbox is on.
# It is not a way to run coding work unconfined.
MAC_SANDBOX_PROVIDER=auto

# Container image for the docker provider. It must carry the toolchain the
# project needs — at minimum node and git for a JavaScript repository.
MAC_SANDBOX_IMAGE=node:22-bookworm-slim

# Read-only tooling mounts, comma-separated. An administrator's explicit
# decision; nothing is inferred. Credential stores and home directories are
# refused here regardless.
MAC_SANDBOX_TOOLING=

# Where node and git live inside the image. Unused by bubblewrap, which sees
# the host's own binaries at their own paths.
MAC_SANDBOX_NODE_PATH=/usr/local/bin/node
MAC_SANDBOX_GIT_PATH=/usr/bin/git

# Unprivileged execution identity inside the sandbox.
MAC_SANDBOX_UID=
MAC_SANDBOX_GID=

# Image used by the sandbox conformance tests. Deliberately tiny: what is under
# test is the mount namespace, not a toolchain.
MAC_SANDBOX_TEST_IMAGE=alpine:3.20

# --- Sprint 3: monday.com ----------------------------------------------------
#
# A monday.com API token, from your avatar → Developers → My Access Tokens.
#
# IDENTITY, and it is not a detail: monday attributes every write to the USER
# who minted the token. A token minted by a person makes Mac's assignments and
# updates appear as that person. For Mac to appear as himself he needs his own
# monday.com user (a paid seat); there is no way to fake it and Sprint 3.1's
# brief is explicit that it must not be faked.
MONDAY_API_TOKEN=

# Mac's monday.com user id, used when he assigns an item to himself. A board
# mapping may override it per board. Without one, `assignToMac` is refused
# with `no_mac_identity` rather than assigning to nobody.
MAC_MONDAY_USER_ID=

# --- Sprint 3: the mailbox (Microsoft Graph) ---------------------------------
#
# An Entra ID app registration using the CLIENT-CREDENTIALS flow. Grant
# `Application Mail.Send` through Exchange Online Application RBAC, scoped to
# Mac's mailbox. Do not add an organisation-wide Entra `Mail.Send` grant as
# well: the grants are additive and the unscoped grant defeats the restriction.
MAC_MAIL_TENANT_ID=
MAC_MAIL_CLIENT_ID=
MAC_MAIL_CLIENT_SECRET=
# The mailbox Mac sends from, e.g. mac.bennet@pac-technologies.com.au
MAC_MAIL_FROM=

# --- Sprint 3.1: the coding agent's own credential ---------------------------
#
# The sandbox environment is built from EMPTY and HOME is a tmpfs, so a coding
# agent inside it holds nothing unless an administrator says so. These two
# settings are how it holds its own provider credential — and only its own.
#
# NAMES, comma-separated. The worker reads each named variable from its own
# environment and passes the value in. Naming a worker or control-plane
# credential (MAC_ENROLLMENT_TOKEN, DATABASE_URL, MONDAY_API_TOKEN, MAC_MAIL_*,
# GITHUB_TOKEN, …) is refused, and the worker refuses to start rather than
# starting with a hole.
MAC_SANDBOX_AGENT_ENV=

# Read-only credential mounts, comma/semicolon separated (colon also works on
# Linux). On the VM this is how a Claude Code subscription credential reaches
# the agent:
#   MAC_SANDBOX_CREDENTIALS=/home/mac/.claude/.credentials.json
# Each is mounted read-only and recorded in the plan as a credential mount.
MAC_SANDBOX_CREDENTIALS=

# DEVELOPMENT ONLY. Let the coding agent run commands with NO sandbox.
#
# The CLI's `acceptEdits` permission mode allows file edits and nothing else,
# so an uncontained agent cannot run the project's tests and cannot commit —
# and in a non-interactive session it cannot ask for permission either. It
# therefore writes a diff nobody has executed. A CONTAINED agent gets command
# access implicitly, because the sandbox is the real boundary; this flag exists
# only for hosts that cannot run one. On a real VM, install a sandbox instead.
MAC_ALLOW_UNCONTAINED_AGENT_COMMANDS=

# --- Sprint 3.2: PAC shared company context ----------------------------------
#
# The human-governed repository that holds PAC's approved company context:
# COMPANY.md, VALUES.md, OPERATING_MODEL.md, SYSTEMS.md, AUTHORITY.md,
# AGENTS.md and GLOSSARY.md, declared by context.yaml.
#
# Mac READS this repository. He has no verb that could write it: the provider
# exposes fetch and read only, and there is no route, service or method anywhere
# in this codebase that commits to it. Proposed changes are recorded as
# proposals for a human to act on.
#
# The URL below IS the intended PAC deployment value. A correct deployment needs
# only to supply a read-only token and switch the feature on in Settings.
MAC_COMPANY_CONTEXT_REPO_URL=https://github.com/PacTechnologiesAus/Company.git
MAC_COMPANY_CONTEXT_REF=main

# Where the bare mirror is cached. Defaults to ~/.mac-bennett/company-context.
# It MUST be outside every coding workspace: a coding agent that could edit
# AUTHORITY.md could edit the document defining its own authority. Mac refuses
# to start a refresh if this path sits inside the worker workspace.
MAC_COMPANY_CONTEXT_DIR=

# A GitHub token with READ-ONLY access to the Company repository
# (fine-grained PAT, Contents: Read; or a GitHub App installation token).
#
# It is handed to git through GIT_ASKPASS, in the child process environment
# only - never in argv, never in the remote URL, and never written to disk. It
# is refused by the worker's sandbox env allowlist (the MAC_COMPANY_ prefix), so
# it cannot reach a coding agent even if an administrator names it explicitly.
MAC_COMPANY_CONTEXT_TOKEN=

# How long a single git operation may take before it is killed. Default 60000.
MAC_COMPANY_CONTEXT_TIMEOUT_MS=

# Opt-in read-only test against the REAL PacTechnologiesAus/Company repository.
# Needs MAC_COMPANY_CONTEXT_TOKEN if the repository is private (it is).
MAC_COMPANY_LIVE_TEST=

# --- Sprint 3.1: opt-in commissioning tests ----------------------------------
# None of these are needed for the standard suite. See docs/integration-setup.md.

# Real monday.com, against a dedicated board.
MAC_MONDAY_LIVE_TEST=
MAC_MONDAY_TEST_BOARD_ID=
MAC_MONDAY_TEST_ITEM_ID=
MAC_MONDAY_TEST_STATUS_COLUMN=
MAC_MONDAY_TEST_STATUS_LABEL=
MAC_MONDAY_UNAPPROVED_BOARD_ID=

# Real mailbox. Sends actual email to an actual person.
MAC_MAIL_LIVE_TEST=
MAC_MAIL_TEST_RECIPIENT=

# The full commissioning night: real monday, real Claude Code, real pull
# requests, real email. Needs a DISPOSABLE repository.
MAC_COMMISSIONING_NIGHT=
MAC_COMMISSIONING_REPO=
MAC_COMMISSIONING_RECIPIENT=

# =============================================================================
# Phase 4 — Teams, Forja, external web research
# =============================================================================
#
# All three are OFF until switched on in Settings as well as configured here.
# Configuration alone changes nothing; the deployment setting is the switch.

# --- Microsoft Teams ---------------------------------------------------------
#
# Mac appears as a BOT application named "Mac Bennett", signed
# "Automation Engineer · PAC Technologies". Teams provides no mechanism for an
# application to post as a human user account, so human attribution is
# deliberately not simulated. See MAC_TEAMS_IDENTITY in the protocol package.
#
# Setup, in order:
#   1. Create an Azure Bot resource in the PAC tenant (single-tenant).
#   2. Set its messaging endpoint to https://<mac host>/api/teams/messages
#   3. Enable the Microsoft Teams channel on it.
#   4. Install the app in the tenant.
#   5. Put the app id, secret and tenant id below.
#   6. Turn Teams on in Settings, and list the AAD object ids of the people
#      who may assign work and approve. THE LIST STARTS EMPTY AND EMPTY MEANS
#      NOBODY: an unrecognised sender may talk to Mac and ask for status, and
#      may not create work or authorise anything.

MAC_TEAMS_APP_ID=
MAC_TEAMS_APP_PASSWORD=
MAC_TEAMS_TENANT_ID=

# Where the Bot Framework publishes its signing keys. Only change this for a
# government cloud. It is NOT taken from the token: an issuer that nominates its
# own key source is a signature check that verifies nothing.
MAC_TEAMS_OPENID_METADATA=
MAC_TEAMS_LOGIN_URL=

# --- Forja -------------------------------------------------------------------
#
# No environment variable issues a Forja credential. An administrator creates a
# client in the Mac UI, which returns the API key and the webhook secret exactly
# once. Only their hashes are stored.

# How long Mac waits for a Forja webhook endpoint. Default 10000.
MAC_FORJA_WEBHOOK_TIMEOUT_MS=

# --- External web search -----------------------------------------------------
#
# NOTHING HAS BEEN PURCHASED AND NO ACCOUNT HAS BEEN CREATED. Three providers
# are implemented against their real APIs; each states exactly what it needs
# from a person, and the Settings page shows that text next to the choice.
#
#   searxng     A SearXNG instance PAC RUNS. No account with anybody and no
#               payment — it is a service PAC hosts. Set MAC_SEARCH_BASE_URL to
#               it, with JSON output enabled. Do not point this at a public
#               community instance: PAC's research queries would go to a
#               stranger's server.
#
#   brave       Requires a Brave Search API subscription key. Brave requires an
#               account and a plan; the free tier still requires a payment
#               method on file. A commercial decision for a person at PAC.
#
#   google_cse  Requires a Google Cloud API key and a Programmable Search
#               Engine id. Queries above the free daily allowance are billed.
#               Also a commercial decision for a person at PAC.
#
# The provider is chosen in Settings. Retrieval is additionally gated on the
# per-project `external_research` capability and on an administrator's
# research-domain allowlist — Mac fetches nothing outside it and does not add
# his own.

MAC_SEARCH_API_KEY=
MAC_SEARCH_ENGINE_ID=
MAC_SEARCH_BASE_URL=
MAC_SEARCH_TIMEOUT_MS=

# --- Opt-in live Teams test --------------------------------------------------
#
# The standard suite signs its own tokens with a locally generated key and needs
# none of this. These are read ONLY by the opt-in live test, under different
# names on purpose: the suite forces MAC_TEAMS_APP_ID to a test value so that a
# developer with real credentials in .env exercises the same code path as CI.
MAC_TEAMS_LIVE_TEST=
MAC_TEAMS_LIVE_APP_ID=
MAC_TEAMS_LIVE_APP_PASSWORD=
MAC_TEAMS_LIVE_TENANT_ID=
MAC_TEAMS_LIVE_CONVERSATION_ID=
MAC_TEAMS_LIVE_SERVICE_URL=
