# ---------------------------------------------------------------------------
# Mac Bennett — Sprint 1 environment
#
# Copy to `.env` in the repository root:   cp .env.example .env
# `.env` is gitignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Control plane (apps/server) -------------------------------------------

NODE_ENV=development
PORT=8080
HOST=127.0.0.1

# Development database (matches docker-compose.yml).
DATABASE_URL=postgres://mac:mac_dev_password@localhost:5433/mac_bennett

# Separate database used by the integration and e2e test suites.
# Tests refuse to run against DATABASE_URL, so these must differ.
TEST_DATABASE_URL=postgres://mac:mac_dev_password@localhost:5433/mac_bennett_test

# Origin allowed to call the API with credentials. In development the Vite dev
# server proxies /api, so requests are same-origin and this is only a fallback.
WEB_ORIGIN=http://localhost:5173

# Cookie name for the human session. Sessions are server-side and revocable;
# there is no signing secret to leak because the cookie carries an opaque
# random token, not a JWT.
SESSION_COOKIE_NAME=mac_session
SESSION_TTL_HOURS=12

# --- Seed administrator ----------------------------------------------------
# `npm run seed` creates this user if it does not already exist.
# CHANGE THESE before the system is reachable by anyone but you.
SEED_ADMIN_EMAIL=admin@pac-technologies.com.au
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Sprint 1 Administrator

# --- Worker (apps/worker) --------------------------------------------------
# The worker normally runs on a separate Linux VM with its own .env.

# Control-plane base URL as seen from the worker VM.
MAC_CONTROL_PLANE_URL=http://127.0.0.1:8080

# One-time enrollment token, minted by an admin in Settings → Workers.
# Only needed for the worker's very first start; afterwards the worker token
# is persisted to MAC_WORKER_STATE_FILE and this can be removed.
MAC_ENROLLMENT_TOKEN=

# Display name this worker registers under. Must be unique.
MAC_WORKER_NAME=mac-worker-01

# Where the issued worker token is persisted (written with mode 0600).
MAC_WORKER_STATE_FILE=./.mac-worker-state.json

# Directory the `workspace_check` job inspects. On the real VM this is Mac's
# persistent workspace root.
MAC_WORKER_WORKSPACE=./workspace

# The worker refuses a plaintext http:// control plane unless this is true.
# Development only — never set this on a VM that talks over a real network.
MAC_ALLOW_INSECURE_HTTP=true

# Heartbeat cadence is normally taken from server settings; this is only the
# value used before the first successful heartbeat.
MAC_HEARTBEAT_SECONDS=10

# --- Sprint 2: coding agent -------------------------------------------------

# Path to the Claude Code CLI, if `claude` on PATH is not directly spawnable.
# Usually unnecessary: the worker resolves the real binary itself, including
# through npm's shim scripts. Set it for unusual installations.
MAC_CLAUDE_CLI_PATH=

# Opt in to the end-to-end test that drives the REAL Claude Code CLI. It spends
# real subscription usage, so it is skipped unless this is exactly "1".
MAC_E2E_REAL_CLAUDE=
